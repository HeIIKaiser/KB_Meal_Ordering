# WebVisitor database (read-only user, allowed only from this host)
WV_DB_HOST=192.168.0.3
WV_DB_PORT=3308
WV_DB_NAME=webbox
WV_DB_USER=meals_ro
WV_DB_PASSWORD=

# Column with the shift name in vis_workinterval (checked at startup)
WV_SHIFT_NAME_COLUMN=NAME

# The app (HTTPS) and the token from Nastavenia → Dochádzka – synchronizácia
APP_URL=https://obedy.example.sk
SYNC_TOKEN=

# Nightly sync time (local time) and how often to ask the app for "Synchronizovať teraz"
SYNC_TIME=02:00
POLL_MINUTES=5
TZ=Europe/Bratislava
