APP_NAME="Jedáleň"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# UI is Slovak. Timestamps are stored in UTC; business logic uses APP_LOCAL_TIMEZONE.
APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sk_SK
APP_LOCAL_TIMEZONE=Europe/Bratislava

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

# Production (Websupport): mysql / mariadb. Local dev may use sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jedalen
DB_USERNAME=jedalen
DB_PASSWORD=
# Slovak collation sorts Č, Š, Ž, Ch correctly in alphabetical lists.
DB_COLLATION=utf8mb4_slovak_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true (HTTPS only)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting has no queue workers: everything runs synchronously.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="obedy@example.sk"
MAIL_FROM_NAME="${APP_NAME}"
